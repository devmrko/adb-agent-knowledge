"""Application factory generated by Python Foundation."""
import secrets
from contextlib import asynccontextmanager
from typing import Annotated, Literal

from fastapi import Depends, FastAPI, Form, Request
from fastapi.responses import JSONResponse
from pydantic import Field, SecretStr
from sqlalchemy import text

from python_foundation.database import create_database
from python_foundation.errors import AuthenticationRequired
from python_foundation.security import Actor, Security, current_actor
from python_foundation.settings import FoundationSettings
from python_foundation.web import configure_logging, install_web


class Settings(FoundationSettings):
    auth_mode: Literal["session", "token", "mixed"] = "__AUTH__"
    __DATABASE_FIELD__


def create_app(settings=None, *, store=None, verifier=None, authenticate_user=None):
    settings = settings or Settings()
    security = Security(settings, store=store, verifier=verifier)
    if settings.auth_mode != "token" and authenticate_user is None:
        if settings.environment == "production" or settings.development_password is None:
            raise ValueError("Configure authenticate_user or FOUNDATION_DEVELOPMENT_PASSWORD for development")
        password = settings.development_password.get_secret_value().encode()
        if len(password) < 12:
            raise ValueError("Development password must have at least 12 characters")
        def authenticate_user(username, supplied):
            matched = secrets.compare_digest(supplied.encode(), password)
            return Actor("local", "user", frozenset({"ROLE_USER"})) if username == "user" and matched else None

    engine = create_database(settings)

    @asynccontextmanager
    async def lifespan(app):
        configure_logging()
        try:
            yield
        finally:
            engine.dispose()

    app = FastAPI(title="__APP_NAME__", lifespan=lifespan, docs_url=None, redoc_url=None, openapi_url=None)
    install_web(app, security)

    @app.get("/actuator/health")
    def health():
        with engine.connect() as connection:
            connection.execute(text("SELECT 1 FROM DUAL" if engine.dialect.name == "oracle" else "SELECT 1"))
        return {"status": "UP"}

    @app.get("/api/ping")
    def ping(actor: Annotated[Actor, Depends(current_actor)]):
        return {"status": "ok", "actor": actor.subject}

    if settings.auth_mode != "token":
        @app.get("/login")
        def csrf(request: Request):
            response = JSONResponse({})
            value = security.begin_login(request, response)
            body = JSONResponse({"csrf": value})
            if "set-cookie" in response.headers:
                body.headers["set-cookie"] = response.headers["set-cookie"]
            return body

        @app.post("/login")
        def login(request: Request, username: Annotated[str, Form(max_length=160)],
                  password: Annotated[str, Form(max_length=1024)], csrf: Annotated[str, Form()]):
            security.check_csrf(request, csrf)
            actor = authenticate_user(username, password)
            if actor is None:
                raise AuthenticationRequired()
            response = JSONResponse({})
            value = security.login(request, response, actor, csrf)
            body = JSONResponse({"csrf": value})
            body.headers["set-cookie"] = response.headers["set-cookie"]
            return body

        @app.post("/logout")
        def logout(request: Request, csrf: Annotated[str, Form()]):
            response = JSONResponse({"status": "logged_out"})
            security.logout(request, response, csrf)
            return response

    return app
