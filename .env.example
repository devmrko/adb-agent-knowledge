# v2: agent uses its own LLM; Kev and embeddings remain independently configured.
GRAPH_EXTRACTION_MODE=agent
# Oracle credentials; never commit .env. Passwords containing # should be quoted.
USER_NAME=
USER_PASSWORD=
WALLET_PASSWORD=
WALLET_DIR=./secrets/wallet
ORACLE_DSN=your_database_low
DATABASE_URL=oracle+oracledb://
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DEV_API_TOKEN=
# local: local Korean model; openai: remote /v1/embeddings (1024 dimensions)
EMBEDDING_PROVIDER=local
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_QUERY_PREFIX=
EMBEDDING_CHUNK_CHARS=512
EMBEDDING_OVERLAP_CHARS=64
EMBEDDING_MODEL=dragonkue/snowflake-arctic-embed-l-v2.0-ko
EMBEDDING_REVISION=55ec6e9358a56d56af759bc8372e970caf8c305f
EMBEDDING_DIMENSIONS=1024
# Apple Silicon: cpu initially, mps after validation; deployment: cuda
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
CHUNK_TOKENS=384
CHUNK_OVERLAP=48
# Explicit exact host allowlist for URL ingestion, HTTPS only.
URL_ALLOWED_HOSTS=docs.oracle.com
# Production: ENVIRONMENT=production and real JWT settings below; dev token is ignored.
ISSUER=https://identity.example.invalid
AUDIENCE=knowledge-api
JWKS_URL=https://identity.example.invalid/keys

# Provisional similarity gate, not a calibrated relevance probability.
SEARCH_MIN_SIMILARITY=0.28
# PPTX uploads may contain large embedded images; text XML is separately bounded.
MAX_PPTX_SOURCE_BYTES=100000000

# Kev is the default decision provider. Remote inference requires explicit opt-in.
KEV_PROVIDER=kev
KEV_ALLOW_REMOTE=false
KEV_API_KEY=
KEV_URL=http://127.0.0.1:8009
KEV_MODEL=kev-latest
KEV_TIMEOUT_SECONDS=2
KEV_LOOKUP_THRESHOLD=0.2
KEV_SAVE_THRESHOLD=0.7
KEV_SAVE_SKIP_THRESHOLD=0.25

# Optional: separately installed Kev checkout (relative to this repository or absolute)
KEV_REPO_DIR=.tools/kev
KEV_RUN=jaredpalmer/kev-4b
# Optional MCP client override for an existing remote HTTPS API
# KNOWLEDGE_API_URL=https://knowledge.example.com
# KNOWLEDGE_API_TOKEN=

# Optional local cross-encoder; disabled until evaluated on your own corpus.
RERANKER_ENABLED=false
RERANKER_MODEL=dragonkue/bge-reranker-v2-m3-ko
RERANKER_REVISION=2aca5884ecac490192af9ebd86836d9073d826cd
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=512
RERANKER_CANDIDATES=20
# Provisional sigmoid cutoff, NOT a relevance probability.
RERANKER_MIN_SCORE=0.5

# Client identity, generated on fresh setup. Use a different stable ID on each machine.
KNOWLEDGE_MACHINE_ID=
KNOWLEDGE_MACHINE_LABEL=

# Auto-connect the browser only on same-origin loopback development requests.
UI_AUTO_CONNECT=true

# Optional native workflow RDF. Run python -m scripts.setup_workflow_rdf once on Oracle first.
WORKFLOW_RDF_ENABLED=false
KEV_GRAPH_LOOKUP_THRESHOLD=0.4
KEV_GRAPH_EXTRACT_THRESHOLD=0.6
KEV_GRAPH_REVIEW_THRESHOLD=0.2

# Automatic graph extraction. Explicitly enable after selecting a provider.
GRAPH_AUTO_ENABLED=false
# Service-side LLM provider; Ollama/vLLM/OpenRouter use this HTTP adapter.
GRAPH_AUTO_PROVIDER=openai_compatible
GRAPH_AUTO_URL=https://openrouter.ai/api/v1
GRAPH_AUTO_MODEL=qwen/qwen3.5-flash-02-23
GRAPH_AUTO_ALLOW_REMOTE=true
OPENROUTER_API_KEY=
GRAPH_AUTO_POLICY=auto_verified
GRAPH_AUTO_MAX_CHARS=24000

# Optional SQL Property Graph (run scripts.setup_property_graph --apply first)
PROPERTY_GRAPH_ENABLED=false

# Optional HTTPS browser login (separate from model API keys)
WEB_PUBLIC_ORIGIN=
WEB_API_KEY_SHA256=
WEB_ACTOR_ISSUER=local-development
WEB_ACTOR_SUBJECT=developer
WEB_SESSION_TTL_SECONDS=604800
# WEB_SESSION_DB=/private/service-state/browser-sessions.db

# Optional SSH MCP: your own host alias and absolute service checkout path
KNOWLEDGE_SSH_HOST=
KNOWLEDGE_REMOTE_DIR=
